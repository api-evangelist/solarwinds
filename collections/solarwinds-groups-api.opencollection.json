{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Loggly Account Groups API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List All Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/groups.json"
          },
          "docs": "Returns all system groups configured in the account."
        },
        {
          "info": {
            "name": "Solarwinds Get Group Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/groups/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource identifier"
              }
            ]
          },
          "docs": "Returns details of a specific group including its member systems."
        }
      ]
    }
  ],
  "bundled": true
}