{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Pingdom API",
    "version": "3.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Checks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List All Checks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/checks",
            "params": [
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of checks to return"
              },
              {
                "name": "offset",
                "value": "10",
                "type": "query",
                "description": "Offset for pagination"
              },
              {
                "name": "tags",
                "value": "example_value",
                "type": "query",
                "description": "Filter by comma-separated tag names"
              },
              {
                "name": "type",
                "value": "http",
                "type": "query",
                "description": "Filter by check type"
              }
            ]
          },
          "docs": "Returns a list of all checks configured in the Pingdom account."
        },
        {
          "info": {
            "name": "Solarwinds Create a New Check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pingdom.com/api/3.1/checks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new uptime check with the specified configuration."
        },
        {
          "info": {
            "name": "Solarwinds Get Detailed Check Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/checks/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              }
            ]
          },
          "docs": "Returns detailed information about a specific check including its configuration and current status."
        },
        {
          "info": {
            "name": "Solarwinds Update a Check",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pingdom.com/api/3.1/checks/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the configuration of an existing check."
        },
        {
          "info": {
            "name": "Solarwinds Delete a Check",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pingdom.com/api/3.1/checks/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              }
            ]
          },
          "docs": "Permanently deletes a check and all associated data."
        }
      ]
    },
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds Get Raw Check Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/results/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              },
              {
                "name": "to",
                "value": "10",
                "type": "query",
                "description": "End of period (Unix timestamp)"
              },
              {
                "name": "from",
                "value": "10",
                "type": "query",
                "description": "Start of period (Unix timestamp)"
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "10",
                "type": "query",
                "description": "Offset for pagination"
              },
              {
                "name": "probes",
                "value": "example_value",
                "type": "query",
                "description": "Filter by comma-separated probe IDs"
              },
              {
                "name": "status",
                "value": "up",
                "type": "query",
                "description": "Filter by result status"
              }
            ]
          },
          "docs": "Returns raw test results for a specific check within a time range."
        }
      ]
    },
    {
      "info": {
        "name": "Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds Get Average Response Time Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/summary.average/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              },
              {
                "name": "from",
                "value": "10",
                "type": "query",
                "description": "Start of period (Unix timestamp)"
              },
              {
                "name": "to",
                "value": "10",
                "type": "query",
                "description": "End of period (Unix timestamp)"
              },
              {
                "name": "includeuptime",
                "value": "true",
                "type": "query",
                "description": "Include uptime information"
              }
            ]
          },
          "docs": "Returns average response time and uptime data for a check over a specified time period."
        },
        {
          "info": {
            "name": "Solarwinds Get Outage Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/summary.outage/:checkid",
            "params": [
              {
                "name": "checkid",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the check"
              },
              {
                "name": "from",
                "value": "10",
                "type": "query",
                "description": "Start of period (Unix timestamp)"
              },
              {
                "name": "to",
                "value": "10",
                "type": "query",
                "description": "End of period (Unix timestamp)"
              }
            ]
          },
          "docs": "Returns a list of outage periods for a specific check."
        }
      ]
    },
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Alert Contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/alerting/contacts"
          },
          "docs": "Returns all alert contacts configured in the account."
        }
      ]
    },
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Alert Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/alerting/teams"
          },
          "docs": "Returns all alert teams configured in the account."
        }
      ]
    },
    {
      "info": {
        "name": "Maintenance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Maintenance Windows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/maintenance"
          },
          "docs": "Returns all maintenance windows configured in the account."
        }
      ]
    },
    {
      "info": {
        "name": "ProbeServers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Probe Servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pingdom.com/api/3.1/probes",
            "params": [
              {
                "name": "onlyactive",
                "value": "true",
                "type": "query",
                "description": "Return only active probes"
              }
            ]
          },
          "docs": "Returns a list of all Pingdom probe servers with their locations."
        }
      ]
    }
  ],
  "bundled": true
}