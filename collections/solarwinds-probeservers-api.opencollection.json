{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Loggly Account ProbeServers API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ProbeServers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Probe Servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/probes",
            "params": [
              {
                "name": "onlyactive",
                "value": "true",
                "type": "query",
                "description": "Return only active probes"
              }
            ]
          },
          "docs": "Returns a list of all Pingdom probe servers with their locations."
        }
      ]
    }
  ],
  "bundled": true
}