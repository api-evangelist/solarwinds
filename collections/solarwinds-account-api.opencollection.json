{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Loggly Account API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds Get Account Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/customer"
          },
          "docs": "Returns customer account information including the customer token and a list of active Loggly users."
        }
      ]
    }
  ],
  "bundled": true
}