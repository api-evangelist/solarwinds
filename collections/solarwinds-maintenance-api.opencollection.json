{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Loggly Account Maintenance API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Maintenance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Maintenance Windows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/maintenance"
          },
          "docs": "Returns all maintenance windows configured in the account."
        }
      ]
    }
  ],
  "bundled": true
}