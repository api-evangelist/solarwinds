{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarWinds Loggly Account ServiceRequests API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ServiceRequests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solarwinds List Service Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.loggly.com/apiv2/service_requests.json",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns a paginated list of service requests."
        },
        {
          "info": {
            "name": "Solarwinds Create a Service Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.loggly.com/apiv2/service_requests.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new service request."
        }
      ]
    }
  ],
  "bundled": true
}