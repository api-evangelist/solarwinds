          "name": "Solarwinds Initiate a Search Query",
          "request": {
            "name": "Solarwinds Initiate a Search Query",
            "description": {
              "content": "Initiates a search query against log events. Returns a search ID (RSID) that can be used with the events endpoint to retrieve results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Search query string using Loggly search syntax"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "Start time for search (ISO 8601 or relative like -24h)"
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<string>",
                  "description": "End time for search"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Maximum number of events to return"
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order"
                }
              ],
              "variable": [
                {
                  "description": "Your Loggly subdomain",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
