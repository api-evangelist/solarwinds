{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/User",
  "title": "User",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "example": "abc123"
    },
    "email": {
      "type": "string",
      "format": "email",
      "example": "user@example.com"
    },
    "is_admin": {
      "type": "boolean",
      "example": true
    }
  }
}